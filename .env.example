# Development only. Generate your own values before using a shared or deployed environment.
COMPOSE_PROJECT_NAME=world-history-practice
FRONTEND_PORT=3200
API_PORT=3201
DB_PORT=55433
POSTGRES_USER=world_history
POSTGRES_PASSWORD=change-this-local-development-password
DB_NAME=world_history_development
# Empty uses the same Nuxt origin for /api/v1. API_PORT remains a compatibility alias.
NUXT_PUBLIC_API_BASE=
FRONTEND_URL=http://localhost:3200
CORS_ORIGINS=http://localhost:3200,http://127.0.0.1:3200
SECRET_KEY_BASE=replace-with-a-random-secret-at-least-64-characters-long-before-deployment
# Optional paid mode: config/exam.json payments.enabled must also be true.
PAID_MEMBERSHIP_ENABLED=false
STRIPE_LIVEMODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NUXT_PUBLIC_SELLER_NAME=
NUXT_PUBLIC_SELLER_REPRESENTATIVE=
NUXT_PUBLIC_SELLER_EMAIL=
NUXT_PUBLIC_SELLER_ADDRESS=
NUXT_PUBLIC_SELLER_PHONE=
SELLER_CONTACT_DISCLOSURE_MODE=public

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exam practice template configuration",
  "type": "object",
  "required": [
    "schema_version",
    "site",
    "exam",
    "categories",
    "payments"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "site": {
      "type": "object",
      "required": [
        "id",
        "name",
        "short_name",
        "exam_name",
        "description",
        "tagline",
        "logo_path",
        "primary_color",
        "contact_email",
        "overview"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "short_name": {
          "type": "string",
          "minLength": 1
        },
        "exam_name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "contact_email": {
          "type": "string"
        },
        "logo_path": {
          "type": "string",
          "pattern": "^/(?!/)"
        },
        "primary_color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "overview": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "body"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string"
              }
            }
          }
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,39}$"
        }
      }
    },
    "exam": {
      "type": "object",
      "required": [
        "set_count",
        "questions_per_exam",
        "choice_labels"
      ],
      "properties": {
        "set_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "questions_per_exam": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "choice_labels": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10
          },
          "maxItems": 10
        }
      }
    },
    "categories": {
      "type": "object",
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,49}$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "minor": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "value",
              "label",
              "major_category_value"
            ],
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,49}$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "major_category_value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "payments": {
      "type": "object",
      "required": [
        "enabled",
        "free_exam_count",
        "amount",
        "currency"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "free_exam_count": {
          "type": "integer",
          "minimum": 0
        },
        "amount": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "const": "jpy"
        }
      }
    }
  }
}
